# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# SECURITY: real secrets must never reach the repository.
# Only .env.example (placeholder values) is tracked.
.env
.env*.local
.env.production

# typescript
*.tsbuildinfo

# prisma
/prisma/*.db
/prisma/*.db-journal

.vercel
.env*

# Original studio photos — source files for scripts/import-gallery.mjs.
# Never shipped: only the processed, EXIF-stripped copies in public/gallery are.
photos-in/

# The template carries no secrets and documents required keys — keep it.
# Must come AFTER the .env* catch-all above: last matching rule wins.
!.env.example
