# =============================================================================
# OnerLab — environment template
# =============================================================================
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Every variable below is parsed and validated by `src/lib/env.ts` at boot,
# so a missing or malformed value fails fast instead of at request time.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development

# --- Database ----------------------------------------------------------------
# PostgreSQL connection strings consumed by Prisma.
#
# ISOLATION: give this app its own database (a dedicated Neon project), not a
# schema on a server shared with other projects — `leads` is a table name many
# projects use. A separate project also keeps compute and quotas separate.
#
# DATABASE_URL is the POOLED endpoint, used for queries at runtime.
# DIRECT_URL is the UNPOOLED endpoint, used only by `prisma migrate` — DDL over
# a transaction pooler is unreliable. On Neon these are the `-pooler` host and
# the plain host respectively.
#
# Production: always require TLS -> &sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Public site origin ------------------------------------------------------
# Canonical production origin. Used for CORS allow-listing, absolute URLs in
# metadata (Open Graph / canonical) and for the sitemap.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Extra origins allowed to call the API (comma-separated, no trailing slash).
# Leave empty in production unless a second domain genuinely needs access.
ALLOWED_ORIGINS=""

# --- Anti-spam / bot protection ----------------------------------------------
# Provider: "turnstile" (Cloudflare), "recaptcha" (Google reCAPTCHA v3) or
# "none" (development only — verification is skipped and a warning is logged).
CAPTCHA_PROVIDER="none"

# Public site key -> rendered into the browser widget.
NEXT_PUBLIC_CAPTCHA_SITE_KEY=""

# Secret key -> used server-side only, never exposed to the client bundle.
CAPTCHA_SECRET_KEY=""

# Minimum score to accept for reCAPTCHA v3 (0.0 – 1.0). Ignored by Turnstile.
CAPTCHA_MIN_SCORE="0.5"

# --- Rate limiting -----------------------------------------------------------
# Sliding window applied per client IP to POST /api/leads.
RATE_LIMIT_MAX_REQUESTS="5"
RATE_LIMIT_WINDOW_MS="60000"

# --- Admin panel (/admin) ----------------------------------------------------
# Generate BOTH with:  npm run admin:password -- "your-password"
#
# The panel stays disabled until both are set, so the public site can run
# without them. The hash uses ':' separators, not '$' — dotenv expands '$NAME'
# and would silently truncate the value.
ADMIN_PASSWORD_HASH=""
ADMIN_SESSION_SECRET=""

# How long a login lasts before the manager must sign in again.
ADMIN_SESSION_TTL_HOURS="12"

# --- Search engines ----------------------------------------------------------
# Ownership tokens. Get them from:
#   Google  -> search.google.com/search-console  (HTML tag method)
#   Yandex  -> webmaster.yandex.ru               (Meta tag method)
# Paste ONLY the content value, not the whole <meta> tag.
GOOGLE_SITE_VERIFICATION=""
YANDEX_SITE_VERIFICATION=""

# --- Logging -----------------------------------------------------------------
# trace | debug | info | warn | error | fatal
LOG_LEVEL="info"
