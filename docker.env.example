# Секреты Docker-версии OnerLab (см. BACKUP.md).
#   cp docker.env.example docker.env
# docker.env в git не попадает. Значения — те же, что в Vercel → Settings →
# Environment Variables. Адрес базы задавать НЕ нужно: он прописан в compose.yaml.

# Вход в админку: npm run admin:password -- "пароль" выводит обе строки.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Капча формы заявки (turnstile | recaptcha | none).
CAPTCHA_PROVIDER=none
CAPTCHA_SECRET_KEY=

LOG_LEVEL=info
